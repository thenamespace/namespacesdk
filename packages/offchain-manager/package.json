{
  "name": "@namespacesdk/offchain-manager",
  "version": "3.0.6",
  "description": "Library for creating and managing offchain subnames",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "sdk",
    "offchain",
    "namespace"
  ],
  "files": [
    "/dist"
  ],
  "author": "Uros Zigic <uros@namespace.tech>",
  "dependencies": {
    "@types/node": "^22.10.5",
    "axios": "^1.7.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "restart": "rimraf dist && tsc && node dist/index.js",
    "dev": "ts-node examples/basic-usage.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:manual": "ts-node scripts/test-manual.ts",
    "test:e2e": "ts-node scripts/test-e2e.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test:coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "dotenv": "^16.3.1",
    "jest": "^29.5.0",
    "msw": "^2.6.8",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.0"
  }
}
