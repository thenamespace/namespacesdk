{
  "name": "@thenamespace/universal-usernames",
  "version": "0.1.0",
  "description": "Profile schema, validator and endpoint adapter for Namespace Universal Usernames: serve ENS subnames from your own HTTPS endpoint.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "universal-usernames": "dist/cli.js"
  },
  "keywords": [
    "ens",
    "ethereum",
    "subnames",
    "usernames",
    "ccip-read",
    "offchain",
    "sdk",
    "namespace"
  ],
  "files": [
    "/dist",
    "/fixtures"
  ],
  "author": "Arti <arti@namespace.ninja>",
  "contributors": [
    "Harpreet Singh <harpreet@namespace.ninja>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thenamespace/namespacesdk",
    "directory": "packages/universal-usernames"
  },
  "homepage": "https://namespace.ninja",
  "bugs": {
    "url": "https://github.com/thenamespace/namespacesdk/issues"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build && npm test",
    "clean": "rimraf dist coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@ensdomains/address-encoder": "2.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "babel-jest": "^29.7.0",
    "esbuild": "0.28.2",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "1.11.1",
    "@ensdomains/content-hash": "3.1.0-rc.1"
  }
}
