# Copy this file to .env and fill in your own values. Never commit .env.
#
# SECURITY: a private key was previously hardcoded in examples/ and pushed to
# this repository. That key is permanently COMPROMISED. Never reuse it, never
# fund it, and never send it any assets. Generate a fresh key for local testing
# and keep it funded with testnet ETH only.

# Private key of the account that pays for and signs mint transactions.
# Use a throwaway testnet account - 0x-prefixed, 32 bytes.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# RPC endpoint used by the examples. Public endpoints are rate limited;
# prefer a provider URL with your own key for anything beyond a quick test.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ALCHEMY_BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/your-alchemy-api-key

# Subname being minted: LABEL.PARENT_NAME (e.g. alice.namespace-test.eth)
PARENT_NAME=namespace-test.eth
LABEL=alice

# Address that receives the subname, and the address that gets written into the
# ENS address record. Usually the same wallet.
MINTER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
OWNER=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
EVM_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# true  -> Base Sepolia / Sepolia testnets
# false -> Base / Ethereum mainnet (spends real funds)
IS_TESTNET=true

# Registration length, in years, for parent names that charge by duration.
EXPIRY_YEARS=1
